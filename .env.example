# Copy this file to .env and fill in values. Never commit .env.

# Local database (SQLite file inside prisma/). Switch to Postgres/Supabase for production.
DATABASE_URL="file:./dev.db"

# Claude API key from https://platform.claude.com (owner-controlled account).
# Leave empty to run in DEMO MODE (clearly labelled placeholder coach replies).
ANTHROPIC_API_KEY=""

# Optional: override the API endpoint. Leave empty for the official API.
COACH_API_BASE_URL=""

# Coaching content: "draft" lets the prototype load draft coaching files.
# In production set to "approved" so only Deanna-approved files are sent to the model.
COACH_CONTENT_LEVEL="draft"

# Set to "true" to show the demo banner and allow loading synthetic demo businesses.
DEMO_MODE="true"

# Public address of the app (used in reminder links). Locally: http://localhost:3000
APP_URL="http://localhost:3000"

# Accountability reminders. Leave empty to keep reminders in preview mode (nothing is sent).
# Email via Resend (resend.com): API key + a verified sender address.
RESEND_API_KEY=""
REMINDER_FROM_EMAIL=""
# SMS via Twilio (twilio.com): account SID, auth token, and the sending number / sender ID.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Community moderators (comma-separated emails). They can pin, hide and remove posts and see reports.
ADMIN_EMAILS=""
# Optional: link to an outside group (e.g. your Facebook group or Skool) shown on the Community page.
COMMUNITY_EXTERNAL_URL=""

# Private pilot: when set, sign-up requires this code. Leave empty locally.
SIGNUP_INVITE_CODE=""
# Max AI coach requests (chat answers + plan builds) per business per 24 hours.
COACH_DAILY_LIMIT="40"
